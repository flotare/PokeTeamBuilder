@prefix : <http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/> .

<http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> rdf:type owl:Ontology ;
                                                                  owl:versionIRI <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#EvolvesTo
:EvolvesTo rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Restriction ;
                         owl:onProperty :EvolvesTo ;
                         owl:someValuesFrom :Pokemon
                       ] ;
           rdfs:range :Pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#EvolvesWithTrigger
:EvolvesWithTrigger rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#ResistantTo
:ResistantTo rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :WeakAgainst .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#StrongAgainst
:StrongAgainst rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :WeakTo ;
               rdfs:domain :Type_pokemon ;
               rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#WeakAgainst
:WeakAgainst rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Type_pokemon ;
             rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#WeakTo
:WeakTo rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        rdfs:domain :Type_pokemon ;
        rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/PokemonhasForCapaciteCapacite
:PokemonhasForCapaciteCapacite rdf:type owl:ObjectProperty ;
                               owl:deprecated "true"^^xsd:boolean .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForCapaciteApprise
:hasForCapaciteApprise rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain :Pokemon ;
                       rdfs:range [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasForCapaciteApprise ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasForCapaciteApprise ;
                                    owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                                    owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                  ] ;
                       rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les 1 à 4 capacités (Capacite) que ce pokémon connaît actuellement."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForCapaciteLearnable
:hasForCapaciteLearnable rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain :Pokemon ;
                         rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                         rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les capacités (Capacite) que ce pokémon peut apprendre."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForCapaciteLearnableByLevel
:hasForCapaciteLearnableByLevel rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                rdfs:domain :Pokemon ;
                                rdfs:range [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasForCapaciteLearnableByLevel ;
                                             owl:someValuesFrom <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                           ] ;
                                rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par montée en niveau."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForCapaciteLearnableByMachines
:hasForCapaciteLearnableByMachines rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                   rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par CT, DT ou bien CS."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForCaracteristic
:hasForCaracteristic rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                     rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Caracteristique_capacite> ;
                     rdfs:comment "Lien entre une capacité (Capacite) et une de ses caractéristique (Caractéristique_Capacité)."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/hasForEvolution
:hasForEvolution rdf:type owl:ObjectProperty ;
                 rdfs:comment "DEPRECATED Lien entre un pokémon (Pokemon) et un de ses pokémons (Pokemon) en lequel il évolue."@fr ;
                 owl:deprecated "true"^^xsd:boolean .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/arthu/ontologies/2026/0/untitled-ontology-4/nom
:nom rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf owl:topDataProperty ;
     rdfs:domain owl:Thing ;
     rdfs:range rdf:langString .


