###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/high-jump-kick
:high-jump-kick rdf:type owl:NamedIndividual ,
                         :Capacite_physique ;
                :Capacite_IsTypeOf :fighting ;
                :nom "high-jump-kick" ;
                :precision_capacite 90 ;
                :puissance_capacite 130 ;
                :description_capacite "Inflige des dégâts réguliers. Si cette capacité manque sa cible, est bloquée par protect ou detect, ou n'a pas d'effet, le lanceur prend des dégâts égaux à la moitié de ses PV max, arrondis à l'unité inférieur. Cette capacité ne peut pas être utilisée quand gravity est active." ;
                :pp_capacite 10 ;
                :priorite_capacite 0 .


