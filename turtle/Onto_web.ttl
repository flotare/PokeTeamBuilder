###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/sandstorm
:sandstorm rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :rock ;
           :nom "sandstorm" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Change la météo en tempête de sable pendant cinq tours. Les Pokémon qui ne sont pas ground, rock, ou steel subissent 1/16 de leurs PV max à la fin de chaque tour. La Défense Spéciale d'origine de chaque Pokémon rock est augmentée de 50 pour la durée de cet effet. La puissance de solar beam est divisée par deux. moonlight, morning sun, et synthesis ne soignent seulement 1/4 des PV max du lanceur." ;
           :pp_capacite 10 ;
           :priorite_capacite 0 .


