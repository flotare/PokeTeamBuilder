:tm35 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Lance-Flammes à un Pokémon compatible.<br> Description en jeu : <br>Invoque une tempête de grêle qui dure cinq tours.<br>Blesse tous les Pokémon, sauf ceux de type Glace." ;
      :nom "tm35" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


