###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/dire-hit
:dire-hit rdf:type owl:NamedIndividual ,
                   :Objet ;
          :effect_name "Effet : Utilisé sur un Pokémon de l'équipe en combat<br>:   Augmente les chances de coups critiques de la cible d'un niveau jusqu'à ce qu'elle quitte le terrain.  Augmente le bonheur de 1/1/0.<br> Description en jeu : <br>Augmente fortement le taux de critiques.<br>Utilisable une seule fois.<br>L’effet disparaît si le Pokémon est retiré." ;
          :nom "dire-hit" ;
          :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/dire-hit.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/dire-hit-2
:dire-hit-2 rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Utilisé sur un Pokémon de l'équipe au combat <br>:   Augmente le taux de coups critiques de la cible de deux niveaux. <br>Cet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.<br> Description en jeu : <br>Augmente le taux de critiques.<br>Plus efficace à chaque utilisation.<br>L’effet se dissipe si le Pokémon est retiré." ;
            :nom "dire-hit-2" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/dire-hit-2.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/dire-hit-3
:dire-hit-3 rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Utilisé sur un Pokémon de l'équipe au combat <br>:   Augmente le taux de coups critiques de la cible de trois niveaux.<br>Cet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.<br> Description en jeu : <br>Augmente fortement le taux de critiques.<br>Plus efficace à chaque utilisation.<br>L’effet se dissipe si le Pokémon est retiré." ;
            :nom "dire-hit-3" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/dire-hit-3.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/disable
:disable rdf:type owl:NamedIndividual ,
                  :Capacite_statut ;
         :Capacite_IsTypeOf :normal ;
         :nom "disable" ;
         :precision_capacite 100 ;
         :puissance_capacite 0 ;
         :description_capacite "Empêche la cible d'utiliser la dernière capacité utilisée, empêchant son utilisation pour 4–7 tours, sélectionné au hasard, ou jusqu'à ce que la cible quitte le terrain. Si la cible n'a pas utilisé de capacité depuis son entrée sur le terrain, si elle a essayé d'utiliser une capacité ce tour et a échoué, si sa dernière capacité utilisée a PP restant, ou si elle a déjà une capacité désactivée, cette capacité échouera." ;
         :pp_capacite 20 ;
         :priorite_capacite 0 .


