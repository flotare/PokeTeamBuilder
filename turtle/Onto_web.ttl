###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/acid-spray
:acid-spray rdf:type owl:NamedIndividual ,
                     :Capacite_speciale ;
            :Capacite_IsTypeOf :poison ;
            :nom "acid-spray" ;
            :precision_capacite 100 ;
            :puissance_capacite 40 ;
            :description_capacite "Inflige des dégâts réguliers. Diminue la Défense Spéciale de la cible de deux niveaux." ;
