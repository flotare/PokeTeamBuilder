###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/echoed-voice
:echoed-voice rdf:type owl:NamedIndividual ,
                       :Capacite_speciale ;
              :Capacite_IsTypeOf :normal ;
              :nom "echoed-voice" ;
              :precision_capacite 100 ;
              :puissance_capacite 40 ;
              :description_capacite "Inflige des dégâts réguliers. Si n'importe quel Pokémon allié a utilisé cette capacité plus tôt ce tour ou le tour précédent, la puissance de cette utilisation est ajoutée à la puissance de cette capacité, jusqu'à un maximum de 200." ;
              :pp_capacite 15 ;
              :priorite_capacite 0 .


