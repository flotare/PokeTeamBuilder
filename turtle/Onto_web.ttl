                  :nom "flyinium-z--held" ;
                  :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/flyinium-z--held.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/focus-band
:focus-band rdf:type owl:NamedIndividual ,
                     :Strategique ;
            :effect_name "Effet : Tenu: Si le porteur subit des dégâts réguliers par lesquels il serait mis KO, cet objet a 10% de chances d'empêcher les PV du porteur de tomber sous 1.<br> Description en jeu : <br>Objet à tenir pouvant parfois empêcher d’être mis K.O.,<br>ne laissant qu’un seul PV." ;
            :nom "focus-band" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/focus-band.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/focus-blast
:focus-blast rdf:type owl:NamedIndividual ,
                      :Capacite_speciale ;
             :Capacite_IsTypeOf :fighting ;
             :nom "focus-blast" ;
             :precision_capacite 70 ;
             :puissance_capacite 120 ;
             :description_capacite "Inflige des dégats réguliers. A une probabilité_d'effet de chances de diminuer la Défense Spéciale de la cible d'un niveau." ;
             :pp_capacite 5 ;
             :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/focus-energy
:focus-energy rdf:type owl:NamedIndividual ,
                       :Capacite_statut ;
              :Capacite_IsTypeOf :normal ;
              :nom "focus-energy" ;
              :precision_capacite 100 ;
              :puissance_capacite 0 ;
              :description_capacite "Le taux de coups critiques est deux niveaux supérieur jusqu'à ce qu'il quitte le terrain. Si le lanceur a déjà utilisé focus energy depuis son entrée sur le terrain, cette capacité échouera. Cet effet est transmis par baton pass." ;
              :pp_capacite 30 ;
              :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/focus-punch
:focus-punch rdf:type owl:NamedIndividual ,
                      :Capacite_physique ;
             :Capacite_IsTypeOf :fighting ;
             :nom "focus-punch" ;
             :precision_capacite 100 ;
             :puissance_capacite 150 ;
             :description_capacite "Inflige des dégâts réguliers. Si le lanceur subit des dégâts ce tour avant de frapper, cette capacité échouera. Cette capacité ne peut pas être copiée par mirror move, ni sélectionnée par assist, metronome, ou sleep talk." ;
             :pp_capacite 20 ;
             :priorite_capacite -3 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/focus-sash
:focus-sash rdf:type owl:NamedIndividual ,
                     :Strategique ;
            :effect_name "Effet : Tenu: Si le porteur a tous ses PV et est touché par des dommages qui devraient le mettre KO, cet objet est consommé et empêche les PV du porteur de tomber en dessous de 1.  Cet effet fonctionne sur des attaques multi-coups, mais ne fonctionne pas contre des effets comme Vœu Destructeur or Prescience.<br> Description en jeu : <br>Objet à tenir. S’il a encore tous ses PV, le porteur<br>pourra éviter d’être mis K.O. en un coup.<br>Il ne conservera alors qu’un seul PV." ;
            :nom "focus-sash" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/focus-sash.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/follow-me
:follow-me rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :normal ;
           :nom "follow-me" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Jusqu'à la fin de ce tour, n'importe quelle capacité qu'un Pokémon adverse qui cible seulement un allié du lanceur ciblera le lanceur à la place. Si les deux Pokémon du même côté du terrain utilisent cette capacité le même tour, le Pokémon qui l'utilise en dernier deviendra la cible. Cet effet prend la priorité sur lightning rod et storm drain. Si l'allié du lanceur se retire, les Pokémon adverses peuvent toujours le frapper avec pursuit. Cette capacité ne peut pas être sélectionnée par assist ou metronome." ;
           :pp_capacite 20 ;
           :priorite_capacite 2 .


