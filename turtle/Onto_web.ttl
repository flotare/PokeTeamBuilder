###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/water-sport
:water-sport rdf:type owl:NamedIndividual ,
                      :Capacite_statut ;
             :Capacite_IsTypeOf :water ;
             :nom "water-sport" ;
             :precision_capacite 100 ;
             :puissance_capacite 0 ;
             :description_capacite "Les capacités fire infligent la moitié des dégâts, peu importe la cible. Si le lanceur quitte le terrain, cet effet prend fin." ;
