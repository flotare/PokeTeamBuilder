###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/power-trip
:power-trip rdf:type owl:NamedIndividual ,
                     :Capacite_physique ;
            :Capacite_IsTypeOf :dark ;
            :nom "power-trip" ;
            :precision_capacite 100 ;
            :puissance_capacite 20 ;
            :description_capacite "Inflige des dégâts réguliers. La puissance est augmentée de 100 de sa valeur d'origine pour chaque niveau que n'importe quelle stat du lanceur a été augmentée. La précision, esquive, et stats diminuées n'affectent pas la puissance de cette capacité. Pour un Pokémon avec toutes les cinq stats modifiées à 6, la puissance de cette capacité est 31." ;
            :pp_capacite 10 ;
            :priorite_capacite 0 .


