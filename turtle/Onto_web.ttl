:tm37 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Tempête de Sable à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur appelle tous les Pokémon de son équipe<br>à attaquer. Plus ils sont nombreux, plus il y a d’attaques." ;
