###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/role-play
:role-play rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :psychic ;
           :nom "role-play" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Le talent du lanceur est remplacé par celui de la cible jusqu'à ce que le lanceur quitte le terrain. Ignore les modifications de précision et d'esquive. Si la cible a flower gift, forecast, illusion, imposter, multitype, stance change, trace, wonder guard, ou zen mode, cette capacité échouera. Cette capacité ne peut pas être copiée par mirror move." ;
           :pp_capacite 10 ;
           :priorite_capacite 0 .


