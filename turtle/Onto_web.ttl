###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/sticky-barb
:sticky-barb rdf:type owl:NamedIndividual ,
                      :Objet ;
             :effect_name "Effet : Tenu: Inflige des dégâts au porteur égaux à 1/8 de ses PV max.  Quand le porteur est touché par une capacité à contact, inflige à l'attaquant 1/8 de ses PV max; si l'attaquant ne tient pas d'objet, il tiendra cet objet.<br> Description en jeu : <br>Objet à tenir. Blesse le porteur à chaque tour.<br>Peut s’accrocher aux ennemis qui attaquent le porteur." ;
             :nom "sticky-barb" ;
             :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/sticky-barb.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/sticky-web
:sticky-web rdf:type owl:NamedIndividual ,
                     :Capacite_statut ;
            :Capacite_IsTypeOf :bug ;
            :nom "sticky-web" ;
            :precision_capacite 100 ;
            :puissance_capacite 0 ;
            :description_capacite "Lance une toile sur le côté du terrain de l'adversaire, qui diminue la Vitesse de n'importe quel Pokémon adverse qui entre sur le terrain d'un niveau. Les Pokémon dans les airs, tels que les types flying et ceux avec levitate, ne sont pas affectés. rapid spin supprime la Toile Gluante du côté du terrain du lanceur; defog la supprime des deux côtés." ;
            :pp_capacite 20 ;
            :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/stockpile
:stockpile rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :normal ;
           :nom "stockpile" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Augmente la Défense et Défense Spéciale du lanceur d'un niveau chacune. Stocke l'énergie utilisée avec spit up et swallow. Jusqu'à trois niveaux d'énergie peuvent être stockés, et tous sont perdus si le lanceur quitte le terrain. L'énergie est encore stockée même si les boost de stat ne peuvent être appliqués. Si le lanceur utilise baton pass, les boosts de stat sont passés normalement, mais pas l'énergie stockée." ;
           :pp_capacite 20 ;
           :priorite_capacite 0 .


