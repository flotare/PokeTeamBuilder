###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/fusion-flare
:fusion-flare rdf:type owl:NamedIndividual ,
                       :Capacite_speciale ;
              :Capacite_IsTypeOf :fire ;
              :nom "fusion-flare" ;
              :precision_capacite 100 ;
              :puissance_capacite 100 ;
              :description_capacite "Inflige des dégâts réguliers. Si un Pokémon allié a utilisé fusion bolt plus tôt ce tour, cette capacité a une puissance double." ;
