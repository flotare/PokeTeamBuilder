###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/exp-charm
:exp-charm rdf:type owl:NamedIndividual ,
                    :Objet_gameplay ;
           :effect_name "Effet : L'effet de cet objet n'est pas précisé.<br> Description en jeu : <br>Un charme permettant aux Pokémon de gagner<br>davantage de Points d’Expérience. Il renferme<br>une espèce de mécanisme." ;
           :nom "exp-charm" ;
