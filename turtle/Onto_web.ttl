###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/safari-ball
:safari-ball rdf:type owl:NamedIndividual ,
                      :Objet ;
             :effect_name "Effet : Utilisé au combat<br>:   Tente de capturer un Pokémon sauvage, utilisant un taux de capture de 1.5x.<br><br>Cet objet ne peut qu'être utilisé dans le great marsh ou kanto safari zone.<br> Description en jeu : <br>Une Poké Ball spéciale anciennement utilisée<br>au Parc Safari de Kanto et au Grand Marais de Sinnoh." ;
             :nom "safari-ball" ;
             :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/safari-ball.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/safeguard
:safeguard rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :normal ;
           :nom "safeguard" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Protège les Pokémon du côté du terrain du lanceur des effets de statuts majeurs et de la confusion pendant cinq tours. N'annule pas les altérations existantes. Cet effet reste même si le lanceur quitte le terrain. Si yawn est utilisée quand cette capacité est active, elle échouera immédiatement. defog utilisé par un adversaire mettra fin à cet effet. Cet effet n'empêche pas la confusion causée par outrage, petal dance, ou thrash." ;
           :pp_capacite 25 ;
           :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/safety-goggles
:safety-goggles rdf:type owl:NamedIndividual ,
                         :Strategique ;
                :effect_name "Effet : Tenu: Empêche les dégâts des capacités à base de poudre et les dégâts de Grêle et Tempête de Sable.<br> Description en jeu : <br>Objet à tenir. Protège le Pokémon contre les dégâts<br>dus à la météo et la plupart des capacités utilisant<br>de la poudre." ;
                :nom "safety-goggles" ;
                :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/safety-goggles.png" .


