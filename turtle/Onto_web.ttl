                 :effect_name "Effet : Contient des informations basic sur le gameplay.<br> Description en jeu : <br>Une petite machine qui enregistre automatiquement<br>les conseils qu’un Dresseur reçoit au cours<br>de ses aventures." ;
                 :nom "adventure-rules" ;
                 :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/adventure-rules.png" .


