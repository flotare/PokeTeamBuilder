###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/reins-of-unity
:reins-of-unity rdf:type owl:NamedIndividual ,
                         :Objet ;
                :effect_name "Effet : L'effet de cet objet n'est pas précisé.<br> Description en jeu : <br>Une courroie faite d’un tissu qui scintille à la lumière.<br>Les humains en offraient autrefois au Seigneur<br>des récoltes en gage de leur gratitude." ;
                :nom "reins-of-unity" ;
                :url_img "https://www.cabinet-merlin.fr/wp-content/uploads/2016/04/dummy-post-square-1.jpg" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/reins-of-unity--merge
:reins-of-unity--merge rdf:type owl:NamedIndividual ,
                                :Objet ;
                       :effect_name "Effet : L'effet de cet objet n'est pas précisé.<br> Description en jeu : <br>Une offrande des humains au roi. Ces rênes permettent<br>d’unir Sylveroy à son fidèle destrier, et renforcent son<br>habilité à prodiguer d’abondantes récoltes." ;
                       :nom "reins-of-unity--merge" ;
                       :url_img "https://www.cabinet-merlin.fr/wp-content/uploads/2016/04/dummy-post-square-1.jpg" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/reins-of-unity--split
:reins-of-unity--split rdf:type owl:NamedIndividual ,
                                :Objet ;
                       :effect_name "Effet : L'effet de cet objet n'est pas précisé.<br> Description en jeu : <br>Une offrande des humains au roi. Ces rênes permettent<br>à ceux qu’elles unissent de se comprendre. Elles<br>permettent aussi de séparer Sylveroy de son destrier." ;
                       :nom "reins-of-unity--split" ;
                       :url_img "https://www.cabinet-merlin.fr/wp-content/uploads/2016/04/dummy-post-square-1.jpg" .


