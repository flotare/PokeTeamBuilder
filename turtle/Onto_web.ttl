###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/life-orb
:life-orb rdf:type owl:NamedIndividual ,
                   :Strategique ;
          :effect_name "Effet : Tenu: Les dégâts des capacités du porteur sont augmentés de 30%.  À chaque tour où le porteur utilise une capacité offensive, il subit 10% de ses PV max en dégâts.<br> Description en jeu : <br>Objet à tenir. Augmente la puissance des capacités,<br>mais dépense des PV à chaque coup." ;
          :nom "life-orb" ;
          :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/life-orb.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/lift-key
:lift-key rdf:type owl:NamedIndividual ,
                   :Objet ;
          :effect_name "Effet : Met en marche l'ascenseur du Repaire Rocket de Céladopole.<br> Description en jeu : <br>Une clé activant l’ascenseur du Repaire de la Team<br>Rocket. Elle porte la marque de l’organisation." ;
          :nom "lift-key" ;
          :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/lift-key.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-ball
:light-ball rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Tenu par Pikachu: Double l'Attaque et l'Attaque Spéciale initiales du porteur.<br> Description en jeu : <br>Objet à faire tenir à Pikachu.<br>Un orbe énigmatique qui augmente son Attaque<br>et son Attaque Spéciale." ;
            :nom "light-ball" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/light-ball.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-clay
:light-clay rdf:type owl:NamedIndividual ,
                     :Strategique ;
            :effect_name "Effet : Tenu: Le Protection et Mur Lumière du porteur créent des effets durant huit tours plutôt que cinq.  Comme cet objet accete la capacité plutôt que la barrière elle-même, l'effet n'est pas perdu si le porteur quitte le combat ou fait tomber cet objet.<br> Description en jeu : <br>Objet à tenir. Prolonge la durée des capacités<br>barrières telles que Mur Lumière et Protection." ;
            :nom "light-clay" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/light-clay.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-of-ruin
:light-of-ruin rdf:type owl:NamedIndividual ,
                        :Capacite_speciale ;
               :Capacite_IsTypeOf :fairy ;
               :nom "light-of-ruin" ;
               :precision_capacite 90 ;
               :puissance_capacite 140 ;
               :description_capacite "Inflige des dégâts réguliers. Le lanceur subit 1/2 des dégâts qu'il inflige en contrecoup." ;
               :pp_capacite 5 ;
               :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-screen
:light-screen rdf:type owl:NamedIndividual ,
                       :Capacite_statut ;
              :Capacite_IsTypeOf :psychic ;
              :nom "light-screen" ;
              :precision_capacite 100 ;
              :puissance_capacite 0 ;
              :description_capacite "Érige une barrière autour du côté du terrain du lanceur qui réduit les dégâts des attaques spéciales de moitié pendant cinq tours. En combats doubles, la réduction est 1/3. Les coups critiques ne sont pas affectés par la barrière. Si le lanceur tient light clay, la barrière reste pendant huit tours. brick break ou defog utilisés par un adversaire détruira la barrière." ;
              :pp_capacite 30 ;
              :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-stone
:light-stone rdf:type owl:NamedIndividual ,
                      :Objet ;
             :effect_name "Effet : Invoque reshiram pour le combat final contre N.<br> Description en jeu : <br>Ce sont les derniers restes du corps de Reshiram.<br>On dit qu’ils attendent l’apparition d’un héros." ;
             :nom "light-stone" ;
             :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/light-stone.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/light-that-burns-the-sky
:light-that-burns-the-sky rdf:type owl:NamedIndividual ,
                                   :Capacite_speciale ;
                          :Capacite_IsTypeOf :psychic ;
                          :nom "light-that-burns-the-sky" ;
                          :precision_capacite 100 ;
                          :puissance_capacite 200 ;
                          :description_capacite "Inflige des dégâts en utilisant soit la stat d'Attaque ou Attaque Spéciale, celle qui est la plus élevée. La détermination de la stat utilisée prend en compte les changements de stat mais pas les objets tenus ou talents." ;
                          :pp_capacite 1 ;
                          :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/like-mail
:like-mail rdf:type owl:NamedIndividual ,
                    :Objet ;
           :effect_name "Effet : Utilisé pour envoyer des messages courts aux autres joueurs via un échange Pokémon.  Les dresseurs peuvent composer un message à partir d'une liste finie de mot en donnant cet objet à un Pokémon.  Une fois prise et lue, un message peut être effacé et cet objet peut être réutilisé, ou le message peut être sauvegardé dans le PC du dresseur.<br><br>Tenu<br>:   Le porteur ne peut pas être placé dans le PC.  N'importe quelle capacité tentant de retirer cet objet du porteur échouera.<br> Description en jeu : <br>Un papier à lettres idéal pour donner des conseils.<br>Peut être tenu et livré par un Pokémon." ;
           :nom "like-mail" ;
           :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/like-mail.png" .


