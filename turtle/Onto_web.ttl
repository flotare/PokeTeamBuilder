###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/petal-dance
:petal-dance rdf:type owl:NamedIndividual ,
                      :Capacite_speciale ;
             :Capacite_IsTypeOf :grass ;
             :nom "petal-dance" ;
             :precision_capacite 100 ;
             :puissance_capacite 120 ;
             :description_capacite "Inflige des dégâts réguliers. Le lanceur est forcé à attaquer avec cette capacité pendant 2–3 tours, sélectionné au hasard. Après le dernier coup, le lanceur devient confus. safeguard ne protège pas contre la confusion de cette capacité." ;
             :pp_capacite 10 ;
             :priorite_capacite 0 .


