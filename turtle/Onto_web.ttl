:blizzard rdf:type owl:NamedIndividual ,
                   :Capacite_speciale ;
          :Capacite_IsTypeOf :ice ;
          :nom "blizzard" ;
          :precision_capacite 70 ;
          :puissance_capacite 110 ;
          :description_capacite "Inflige des dégâts réguliers. A une probabilité_d'effet de chances de geler la cible. Sous hail, cette capacité a 100 de puissance. Elle a aussi 100 - accuracy de chances de passre à travers la protection de protect et detect." ;
