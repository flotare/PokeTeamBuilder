                      :Capacite_physique ;
             :Capacite_IsTypeOf :fire ;
             :nom "sacred-fire" ;
             :precision_capacite 95 ;
             :puissance_capacite 100 ;
             :description_capacite "Inflige des dégâts réguliers. A une probabilité_d'effet de chances de brûler la cible. Les Pokémon gelés peuvent utiliser cette capacité, auquel cas ils dégèleront." ;
