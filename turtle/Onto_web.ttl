:oran-berry rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Tenu au combat<br>:   Quand le porteur a 1/2 de ses PV max restants ou moins, cela consomme cet objet pour restaurer 10 PV.<br><br>Utilisé sur un Pokémon de l'équipe<br>:   Restaure 10 PV.<br> Description en jeu : <br>Une Baie qui restaure 10 PV lorsqu’elle est tenue<br>par un Pokémon." ;
            :nom "oran-berry" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/oran-berry.png" .


