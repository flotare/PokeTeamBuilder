###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/life-dew
:life-dew rdf:type owl:NamedIndividual ,
                   :Capacite_statut ;
          :Capacite_IsTypeOf :water ;
          :nom "life-dew" ;
          :precision_capacite 100 ;
          :puissance_capacite 0 ;
          :description_capacite "Le lanceur projette une eau mystérieuse autour du terrain pour restaurer ses PV et ceux de ses alliés au combat." ;
