###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/moon-ball
:moon-ball rdf:type owl:NamedIndividual ,
                    :Objet ;
           :effect_name "Effet : Utilisé par un dresseur en combat <br>:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.<br>      <br>Si le Pokémon sauvage est un clefairy, nidoran m, nidoran f, jigglypuff, skitty, ou une de leurs évolutions, le Pokémon sauvage a 4× son taux de capture.<br> Description en jeu : <br>Une Poké Ball un peu spéciale qui fonctionne<br>particulièrement bien sur les Pokémon évoluant<br>avec une Pierre Lune." ;
           :nom "moon-ball" ;
           :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/moon-ball.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/moon-flute
:moon-flute rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Fait évoluer Doudou en Lunala quand utilisé à l'Autel de la Lune.<br> Description en jeu : <br>Une flûte dont le timbre permettait d’exprimer<br>sa reconnaissance au Pokémon légendaire de la lune." ;
            :nom "moon-flute" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/moon-flute.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/moon-stone
:moon-stone rdf:type owl:NamedIndividual ,
                     :Objet_evolution ;
            :effect_name "Effet : Utilisé sur un Pokémon de l'équipe<br>:   Fait évoluer un clefairy en clefable, un jigglypuff en wigglytuff, un munna en musharna, un nidorina en nidoqueen, un nidorino en nidoking, ou un skitty en delcatty.<br> Description en jeu : <br>Une pierre étrange qui fait évoluer certaines espèces<br>de Pokémon. Elle est sombre comme la nuit." ;
            :nom "moon-stone" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/moon-stone.png" .


