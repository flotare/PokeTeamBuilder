###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/instruct
:instruct rdf:type owl:NamedIndividual ,
                   :Capacite_statut ;
          :Capacite_IsTypeOf :psychic ;
          :nom "instruct" ;
          :precision_capacite 100 ;
          :puissance_capacite 0 ;
          :description_capacite "La cible utilise immédiatement sa capacité utilisé la plus récemment. Ceci est indépendant de l'action normale de la cible pour ce tour i.e., elle peut finir par agir deux fois, mais fonctionne normalement sinon, incluant la déduction de PP. Cet effet fonctionne pour les capacités entravées et ignore torment." ;
          :pp_capacite 15 ;
          :priorite_capacite 0 .


