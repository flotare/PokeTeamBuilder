### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#stored-power
:stored-power rdf:type owl:NamedIndividual ,
                             :Capacite_speciale ;
                    :Capacite_IsTypeOf :psychic ;
                    :puissance_capacite 20 ;
                    :pp_capacite 10 ;
                    :priorite_capacite 0 ;
