### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#ice-ball
:ice-ball rdf:type owl:NamedIndividual ,
                             :Capacite_physique ;
                    :Capacite_IsTypeOf :ice ;
                    :puissance_capacite 30 ;
                    :pp_capacite 20 ;
                    :priorite_capacite 0 ;
