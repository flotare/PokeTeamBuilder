###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/defog
:defog rdf:type owl:NamedIndividual ,
                :Capacite_statut ;
       :Capacite_IsTypeOf :flying ;
       :nom "defog" ;
       :precision_capacite 100 ;
       :puissance_capacite 0 ;
       :description_capacite "Diminue l'esquive de la cible d'un niveau. Dissipe le brouillard. Supprime les effets de mist, light screen, reflect, safeguard, spikes, stealth rock, et toxic spikes du côté du terrain de la cible. Si la cible est protégée par mist, elle empêche l'esquive de changer, puis est supprimée par cette capacité." ;
       :pp_capacite 15 ;
       :priorite_capacite 0 .


