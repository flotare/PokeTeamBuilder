###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/freeze-dry
:freeze-dry rdf:type owl:NamedIndividual ,
                     :Capacite_speciale ;
            :Capacite_IsTypeOf :ice ;
            :nom "freeze-dry" ;
            :precision_capacite 100 ;
            :puissance_capacite 70 ;
            :description_capacite "Inflige des dégâts réguliers. Cette capacité est super efficace contre le type water. Les autres types de la cible affectent les dégâts normalement. Si le type de cette capacité est changé, elle reste super effiicace contre l'Eau peu importe son type." ;
            :pp_capacite 20 ;
            :priorite_capacite 0 .


