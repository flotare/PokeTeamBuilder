###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/secret-key
:secret-key rdf:type owl:NamedIndividual ,
                     :Objet_evenementiel ;
            :effect_name "Effet : Utilisé par le dresseur dans le Centre Galactique de Vestigion, au rez-de-chaussée, à gauche de la télévision<br>:   Débloque la salle secrète rotom, dans laquelle se trouvent cinq appareils permettant de changer la forme de Motisma.<br> Description en jeu : <br>Une clé destinée à une serrure très complexe.<br>Ouvre une porte en transmettant un signal électrique." ;
            :nom "secret-key" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/secret-key.png" .


