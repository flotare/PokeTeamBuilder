###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/leech-seed
:leech-seed rdf:type owl:NamedIndividual ,
                     :Capacite_statut ;
            :Capacite_IsTypeOf :grass ;
            :nom "leech-seed" ;
            :precision_capacite 90 ;
            :puissance_capacite 0 ;
            :description_capacite "Plante une graine dans la cible qui draine 1/8 de ses PV max à la fin de chaque tour et soigne le lanceur de la quantité subie. N'a pas d'effet sur les Pokémon grass. La graine reste jusqu'à ce que la cible quitte le terrain. Le lanceur prend des dégâts au lieu d'être soigné si la cible a liquid ooze. rapid spin supprimera cet effet. Cet effet est transmis par baton pass." ;
            :pp_capacite 10 ;
            :priorite_capacite 0 .


