###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm87
:tm87 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Vantardise à un Pokémon compatible.<br> Description en jeu : <br>Aspire la force vitale de l’ennemi par un baiser.<br>Rend au lanceur un nombre de PV supérieur ou égal<br>à la moitié des dégâts infligés." ;
      :nom "tm87" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm88
:tm88 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Picore à un Pokémon compatible.<br> Description en jeu : <br>Pendant cinq tours, les Pokémon au sol récupèrent<br>quelques PV à chaque tour et la puissance<br>des capacités de type Plante augmente." ;
      :nom "tm88" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm89
:tm89 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Demi-Tour à un Pokémon compatible.<br> Description en jeu : <br>Pendant cinq tours, les Pokémon au sol ne peuvent<br>pas subir d’altération de statut et la puissance<br>des capacités de type Dragon est divisée par deux." ;
      :nom "tm89" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm90
:tm90 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Clonage à un Pokémon compatible.<br> Description en jeu : <br>Pendant cinq tours, le terrain se charge d’électricité.<br>Les Pokémon au sol ne peuvent pas s’endormir<br>et la puissance des capacités de type Électrik augmente." ;
      :nom "tm90" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm91
:tm91 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Luminocanon à un Pokémon compatible.<br> Description en jeu : <br>Pendant cinq tours, les Pokémon au sol ne peuvent<br>plus subir d’attaques prioritaires et la puissance<br>des capacités de type Psy augmente." ;
      :nom "tm91" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm92
:tm92 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Distorsion à un Pokémon compatible.<br> Description en jeu : <br>Attaque avec des flammes brûlantes soufflées<br>de la bouche du lanceur. Diminue l’Attaque Spéciale<br>de l’ennemi." ;
      :nom "tm92" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm93
:tm93 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend wild charge à un Pokémon compatible.<br> Description en jeu : <br>Le corps du lanceur produit des ondes anormales<br>qui enveloppent l’ennemi et diminuent beaucoup<br>son Attaque Spéciale." ;
      :nom "tm93" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm94
:tm94 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend rock smash à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur retient ses coups pour que l’ennemi<br>garde au moins 1 PV et ne tombe pas K.O." ;
      :nom "tm94" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm95
:tm95 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend snarl à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur attaque avec une lame d’air qui fend tout.<br>Peut aussi apeurer l’ennemi." ;
      :nom "tm95" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm96
:tm96 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend la CT96 à un Pokémon.<br> Description en jeu : <br>Le lanceur transperce la cible avec sa corne effilée.<br>Touche toujours l’ennemi." ;
      :nom "tm96" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm97
:tm97 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend la CT97 à un Pokémon.<br> Description en jeu : <br>Le lanceur pivote pour prendre de l’élan et infliger<br>des dégâts." ;
      :nom "tm97" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm98
:tm98 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend la CT98 à un Pokémon.<br> Description en jeu : <br>Le lanceur attaque en utilisant sa frustration. S’il a<br>utilisé une capacité qui a échoué au tour précédent,<br>la puissance de Trépignement est doublée." ;
      :nom "tm98" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm99
:tm99 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend la CT99 à un Pokémon.<br> Description en jeu : <br>Le lanceur balaie violemment le camp adverse<br>avec son immense queue. Baisse l’Attaque de la cible." ;
      :nom "tm99" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


