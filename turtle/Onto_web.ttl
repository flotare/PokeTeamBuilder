###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/air-balloon
:air-balloon rdf:type owl:NamedIndividual ,
                      :Strategique ;
             :effect_name "Effet : Tenu :   Le porteur est immunisé aux capacités de type ground, spikes, toxic spikes, et arena trap.<br><br>    Cet effet ne s'applique pas sous gravity ou ingrain.<br><br>    Quand le porteur subit des dégâts d'une capacité, cet objet est consommé.<br> Description en jeu : <br>Objet à tenir. Permet au porteur de flotter dans les airs.<br>Il éclate quand le porteur encaisse une attaque." ;
             :nom "air-balloon" ;
             :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/air-balloon.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/air-cutter
:air-cutter rdf:type owl:NamedIndividual ,
                     :Capacite_speciale ;
            :Capacite_IsTypeOf :flying ;
            :nom "air-cutter" ;
            :precision_capacite 95 ;
            :puissance_capacite 60 ;
            :description_capacite "Inflige des dégâts réguliers. Le taux de coups critiques du lanceur est un niveau supérieur en utilisant cette capacité." ;
            :pp_capacite 25 ;
            :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/air-mail
:air-mail rdf:type owl:NamedIndividual ,
                   :Objet ;
          :effect_name "Effet : Utilisé pour envoyer des messages courts aux autres joueurs via un échange Pokémon.  Les dresseurs peuvent composer un message à partir d'une liste finie de mot en donnant cet objet à un Pokémon.  Une fois prise et lue, un message peut être effacé et cet objet peut être réutilisé, ou le message peut être sauvegardé dans le PC du dresseur.<br><br>Tenu<br>:   Le porteur ne peut pas être placé dans le PC.  N'importe quelle capacité tentant de retirer cet objet du porteur échouera.<br> Description en jeu : <br>Stationery featuring a print of<br>colorful letter sets.<br>Let a Pokémon hold it for delivery." ;
          :nom "air-mail" ;
          :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/air-mail.png" .


