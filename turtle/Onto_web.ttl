###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/heal-ball
:heal-ball rdf:type owl:NamedIndividual ,
                    :Objet ;
           :effect_name "Effet : Utilisé au combat<br>:   Tente de capturer un Pokémon sauvage, utilisant un taux de capture de 1x.  Les PV du Pokémon capturé sont immédiatement restaurés. Les PP de toutes ses capacités sont restaurées, et n'importe quelle altération de statut est soignée.<br><br>    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.<br> Description en jeu : <br>Une Poké Ball de soin qui rend tous ses PV au Pokémon<br>attrapé et qui soigne toutes ses altérations de statut." ;
           :nom "heal-ball" ;
           :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/heal-ball.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/heal-bell
:heal-bell rdf:type owl:NamedIndividual ,
                    :Capacite_statut ;
           :Capacite_IsTypeOf :normal ;
           :nom "heal-bell" ;
           :precision_capacite 100 ;
           :puissance_capacite 0 ;
           :description_capacite "Supprime les effets majeurs de statut et la confusion de tous les Pokémon de l'équipe du lanceur." ;
           :pp_capacite 5 ;
           :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/heal-block
:heal-block rdf:type owl:NamedIndividual ,
                     :Capacite_statut ;
            :Capacite_IsTypeOf :psychic ;
            :nom "heal-block" ;
            :precision_capacite 100 ;
            :puissance_capacite 0 ;
            :description_capacite "Pour les cinq prochains tours, la cible ne peut pas utiliser de capacités qui restaurent seulement les PV, et les effets des capacités qui soignent sont désactivés. Les capacités qui volent des PV peuvent encore être utilisées, mais infligeront seulement des dégâts et ne soigneront pas la cible." ;
            :pp_capacite 15 ;
            :priorite_capacite 0 .


