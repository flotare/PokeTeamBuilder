:mineral rdf:type owl:NamedIndividual ,
                  :Groupe_oeuf ;
         :nom "mineral" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/minimize
:minimize rdf:type owl:NamedIndividual ,
                   :Capacite_statut ;
          :Capacite_IsTypeOf :normal ;
          :nom "minimize" ;
          :precision_capacite 100 ;
          :puissance_capacite 0 ;
          :description_capacite "Augmente l'esquive de la cible de deux niveaux. stomp et steamroller ont une puissance double contre les Pokémon qui ont utilisé cette capacité depuis leur entrée sur le terrain." ;
          :pp_capacite 10 ;
          :priorite_capacite 0 .


