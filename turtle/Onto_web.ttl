:heal-powder rdf:type owl:NamedIndividual ,
                      :Objet ;
             :effect_name "Effet : Utilisé sur un Pokémon de l'équipe<br>:   Soigne n'importe quelle altération de statut.  Diminue le bonheur de 5/5/10.<br> Description en jeu : <br>Une poudre médicinale très amère.<br>Soigne toutes les altérations de statut d’un Pokémon." ;
             :nom "heal-powder" ;
             :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/heal-powder.png" .


