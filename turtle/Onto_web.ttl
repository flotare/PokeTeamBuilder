###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ability-capsule
:ability-capsule rdf:type owl:NamedIndividual ,
                          :Objet ;
                 :effect_name "Effet : Permet à un Pokémon d'alterner entre ses deux Talents (non cachés) possibles.<br> Description en jeu : <br>Une capsule permettant à un Pokémon pouvant<br>avoir deux talents de passer de l’un à l’autre." ;
                 :nom "ability-capsule" ;
                 :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/ability-capsule.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ability-patch
:ability-patch rdf:type owl:NamedIndividual ,
                        :Objet ;
               :effect_name "Effet : L'effet de cet objet n'est pas précisé.<br> Description en jeu : <br>Un objet qui permet de remplacer le talent ordinaire<br>d’un Pokémon par un talent rare." ;
               :nom "ability-patch" ;
               :url_img "https://www.cabinet-merlin.fr/wp-content/uploads/2016/04/dummy-post-square-1.jpg" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ability-shield
:ability-shield rdf:type owl:NamedIndividual ,
                         :Strategique ;
                :effect_name "Effet : L'effet de cet objet n'est pas précisé." ;
                :nom "ability-shield" ;
                :url_img "https://www.cabinet-merlin.fr/wp-content/uploads/2016/04/dummy-post-square-1.jpg" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ability-urge
:ability-urge rdf:type owl:NamedIndividual ,
                       :Objet ;
              :effect_name "Effet : Utilisé sur un Pokémon de l'équipe au combat <br>:   Sélectionne un autre Pokémon allié au hasard.  Si le talent de ce Pokémon est normalement activé par une condition—i.e., non continu ou passif—son effet est activé de force. <br><br>Cet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.<br> Description en jeu : <br>Déclenche le talent d’un Pokémon de l’équipe." ;
              :nom "ability-urge" ;
              :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/ability-urge.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/abomasite
:abomasite rdf:type owl:NamedIndividual ,
                    :Mega-gemme ;
           :effect_name "Effet : Tenu: Permet à Blizzaroi de Méga-Évoluer en Méga-Blizzaroi.<br> Description en jeu : <br>Une variété de Méga-Gemme.<br>Tenue par un Blizzaroi, elle lui permet de<br>méga-évoluer durant un combat." ;
           :nom "abomasite" ;
           :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/abomasite.png" .


