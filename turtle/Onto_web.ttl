###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/embargo
:embargo rdf:type owl:NamedIndividual ,
                  :Capacite_statut ;
         :Capacite_IsTypeOf :dark ;
         :nom "embargo" ;
         :precision_capacite 100 ;
         :puissance_capacite 0 ;
         :description_capacite "La cible ne peut pas utiliser son objet tenu pendant cinq tours. Si la cible quitte le terrain, cet effet prend fin. Si un Pokémon sous cet effet utilise bug bite ou pluck sur un Pokémon portant une baie, la baie est détruite mais pas utilisée. Si un Pokémon sous cet effet utilise fling, elle échouera. Cet effet est transmis par baton pass." ;
         :pp_capacite 15 ;
         :priorite_capacite 0 .


