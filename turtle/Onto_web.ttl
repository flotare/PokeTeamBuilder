###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/uproar
:uproar rdf:type owl:NamedIndividual ,
                 :Capacite_speciale ;
        :Capacite_IsTypeOf :normal ;
        :nom "uproar" ;
        :precision_capacite 100 ;
        :puissance_capacite 90 ;
        :description_capacite "Inflige des dégâts réguliers. Le lanceur est forcé à utiliser cette capacité pendant 2–5 tours, sélectionné au hasard. Tous les Pokémon du terrain se réveillent, et aucun ne peut s'endormir jusqu'à ce que le verrouillage prenne fin. Les Pokémon ne peuvent pas utiliser rest pendant cet effet. Cette capacité ne peut pas être sélectionnée par sleep talk." ;
        :pp_capacite 10 ;
        :priorite_capacite 0 .


