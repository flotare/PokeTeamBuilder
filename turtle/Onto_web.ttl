:tm23 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Queue de Fer à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur attaque la cible et vole son objet.<br>Le lanceur ne peut rien voler s’il tient déjà un objet." ;
      :nom "tm23" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm24
:tm24 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Tonnerre à un Pokémon compatible.<br> Description en jeu : <br>Une attaque qui ne fonctionne que si le lanceur<br>est endormi. Le boucan peut aussi apeurer l’ennemi." ;
      :nom "tm24" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm25
:tm25 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Fatal-Foudre à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur se protège de toutes les attaques.<br>Peut échouer si utilisée plusieurs fois de suite." ;
      :nom "tm25" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm26
:tm26 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Séisme à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur fait une grimace qui effraie l’ennemi<br>et réduit beaucoup sa Vitesse." ;
      :nom "tm26" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm27
:tm27 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Retour à un Pokémon compatible.<br> Description en jeu : <br>Une bourrasque de vent froid blesse l’ennemi.<br>Réduit aussi sa Vitesse." ;
      :nom "tm27" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm28
:tm28 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Tunnel à un Pokémon compatible.<br> Description en jeu : <br>Une attaque qui convertit la moitié des dégâts<br>infligés en PV pour le lanceur." ;
      :nom "tm28" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm29
:tm29 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Psyko à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur fait les yeux doux pour berner l’ennemi<br>et beaucoup réduire son Attaque." ;
      :nom "tm29" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm30
:tm30 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Ball'Ombre à un Pokémon compatible.<br> Description en jeu : <br>Le lanceur frappe l’ennemi avec des ailes d’acier.<br>Peut aussi augmenter la Défense du lanceur." ;
      :nom "tm30" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm31
:tm31 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Casse-Brique à un Pokémon compatible.<br> Description en jeu : <br>Si l’ennemi est du sexe opposé, il tombe amoureux<br>et rechigne alors à attaquer." ;
      :nom "tm31" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm32
:tm32 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Reflet à un Pokémon compatible.<br> Description en jeu : <br>Une tempête de sable blesse tous les Pokémon pendant<br>cinq tours, sauf ceux de type Roche, Sol ou Acier.<br>Augmente la Défense Spéciale des Pokémon Roche." ;
      :nom "tm32" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm33
:tm33 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Protection à un Pokémon compatible.<br> Description en jeu : <br>Invoque de fortes pluies qui durent cinq tours,<br>augmentant la puissance des capacités de type Eau<br>et baissant celle des capacités de type Feu." ;
      :nom "tm33" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/tm34
:tm34 rdf:type owl:NamedIndividual ,
               :Objet ;
      :effect_name "Effet : Apprend Onde de Choc à un Pokémon compatible.<br> Description en jeu : <br>Fait briller le soleil pendant cinq tours, augmentant<br>la puissance des capacités de type Feu et baissant<br>celle des capacités de type Eau." ;
      :nom "tm34" ;
      :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/tm-normal.png" .


