            :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/acro-bike
:acro-bike rdf:type owl:NamedIndividual ,
                    :Objet_gameplay ;
           :effect_name "Effet : Augmente la vitesse de déplacement à l'extérieur ou dans les grottes.  Plus lent que le mach bike.  Permet d'effectuer diverses figures, permettant au dresseur d'atteindre certaines zones spéciales.<br> Description en jeu : <br>Un vélo pliable qui permet de bondir et de rouler<br>sur la roue arrière." ;
           :nom "acro-bike" ;
           :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/acro-bike.png" .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/acrobatics
:acrobatics rdf:type owl:NamedIndividual ,
                     :Capacite_physique ;
            :Capacite_IsTypeOf :flying ;
            :nom "acrobatics" ;
            :precision_capacite 100 ;
            :puissance_capacite 55 ;
            :description_capacite "Inflige des dégâts réguliers. Si le lanceur n'a pas d'objet tenu, cette capacité a une puissance double." ;
            :pp_capacite 15 ;
            :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/acupressure
:acupressure rdf:type owl:NamedIndividual ,
                      :Capacite_statut ;
             :Capacite_IsTypeOf :normal ;
             :nom "acupressure" ;
             :precision_capacite 100 ;
             :puissance_capacite 0 ;
             :description_capacite "Augmente l'une des stats de la cible de deux niveaux. La stat augmentée est choisie au hasard parmi n'importe quelle stat qui peut être augmentée de deux niveaux. Si aucune stat n'est éligible, cette capacité échouera. Si la cible a un substitute, cette capacité n'aura pas d'effet, même si le lanceur est la cible. Cette capacité ne peut pas être copiée par mirror move." ;
             :pp_capacite 30 ;
             :priorite_capacite 0 .


