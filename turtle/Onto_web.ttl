                       :Capacite_physique ;
              :Capacite_IsTypeOf :electric ;
              :nom "plasma-fists" ;
              :precision_capacite 100 ;
              :puissance_capacite 100 ;
              :description_capacite "Après avoir infligé des dégâts, toutes les capacités de type Normal deviennent de type Electric pour le reste du tour, incluant les capacités de statut. Cet effet est appliqué après les talents de changement de type, tels que Peau Féérique et Normalise." ;
              :pp_capacite 15 ;
              :priorite_capacite 0 .


