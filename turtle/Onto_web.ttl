###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/guard-spec
:guard-spec rdf:type owl:NamedIndividual ,
                     :Objet ;
            :effect_name "Effet : Utilisé sur un Pokémon de l'équipe en combat<br>:   Empêche les stats de la cible d'être diminuées pour les cinq prochains tours.  Augmente le bonheur de 1/1/0.<br> Description en jeu : <br>Empêche la baisse des stats de tous les Pokémon<br>de l’équipe pendant cinq tours." ;
            :nom "guard-spec" ;
            :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/guard-spec.png" .


