###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/fury-attack
:fury-attack rdf:type owl:NamedIndividual ,
                      :Capacite_physique ;
             :Capacite_IsTypeOf :normal ;
             :nom "fury-attack" ;
             :precision_capacite 85 ;
             :puissance_capacite 15 ;
             :description_capacite "Inflige des dégâts réguliers. Touche 2–5 fois en un tour. A 3/8 chances chacune de frapper 2 ou 3 fois, et 1/8 chance chacune de frapper 4 ou 5 fois. Moyenne à 3 coups par utilisation." ;
             :pp_capacite 20 ;
             :priorite_capacite 0 .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/fury-cutter
:fury-cutter rdf:type owl:NamedIndividual ,
                      :Capacite_physique ;
             :Capacite_IsTypeOf :bug ;
             :nom "fury-cutter" ;
             :precision_capacite 95 ;
             :puissance_capacite 40 ;
             :description_capacite "Inflige des dégâts réguliers. La puissance double après chaque fois que cette capacité est utilisée, consécutivement ou non, jusqu'à un maximum de 16x. Si cette capacité manque sa cible ou que le lanceur quitte le terrain, la puissance se réinitialise." ;
             :pp_capacite 20 ;
             :priorite_capacite 0 .


