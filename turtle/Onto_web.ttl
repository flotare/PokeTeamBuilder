:enigma-stone rdf:type owl:NamedIndividual ,
                       :Objet_evenementiel ;
              :effect_name "Effet : Quand amené au musée de pewter city, latias ou latios attaque le dresseur.  <br><br>Le Pokémon qui apparaît sera celui que l'on ne peut pas rencontrer errant dans la nature.<br> Description en jeu : <br>Un orbe cristallin fraîchement déterré.<br>Il est encore pris dans une gangue de terre et de roche." ;
              :nom "enigma-stone" ;
              :url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/enigma-stone.png" .


