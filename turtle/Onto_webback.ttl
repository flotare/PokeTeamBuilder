###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsMachineOfCapacite
:IsMachineOfCapacite rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :Objet_capacitaire ;
                     rdfs:range :Capacite .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Lieu_IsLocatedIn
:Lieu_IsLocatedIn rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:FunctionalProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Lieu ;
                  rdfs:range :Lieu .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Object_IsLocatedIn
:Object_IsLocatedIn rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    owl:inverseOf :hasForFoundableItems ;
                    rdfs:domain :Objet ;
                    rdfs:range :Lieu .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Pokemon_IsTypeOf
:Pokemon_IsTypeOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Pokemon ;
                  rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ResistantTo
:ResistantTo rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :WeakAgainst ;
             rdfs:domain :Type_pokemon ;
             rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/StrongAgainst
:StrongAgainst rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :WeakTo ;
               rdfs:domain :Type_pokemon ;
               rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/TriggerLinkedToObject
:TriggerLinkedToObject rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Utilisation_Objet ;
                       rdfs:range :Objet .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/WeakAgainst
:WeakAgainst rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Type_pokemon ;
             rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/WeakTo
:WeakTo rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        rdfs:domain :Type_pokemon ;
        rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise
:hasForCapaciteApprise rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain :Pokemon ;
                       rdfs:range :Capacite ;
                       rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les 1 à 4 capacités (Capacite) que ce pokémon connaît actuellement."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnable
:hasForCapaciteLearnable rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain :Pokemon ;
                         rdfs:range :Capacite ;
                         rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les capacités (Capacite) que ce pokémon peut apprendre."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnableByLevel
:hasForCapaciteLearnableByLevel rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                rdfs:domain :Pokemon ;
                                rdfs:range [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasForCapaciteLearnableByLevel ;
                                             owl:someValuesFrom :Capacite
                                           ] ;
                                rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par montée en niveau."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnableByMachines
:hasForCapaciteLearnableByMachines rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                   rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par CT, DT ou bien CS."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCaracteristic
:hasForCaracteristic rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain :Capacite ;
                     rdfs:range :Caracteristique_capacite ;
                     rdfs:comment "Lien entre une capacité (Capacite) et une de ses caractéristique (Caractéristique_Capacité)."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForFoundableItems
:hasForFoundableItems rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Lieu ;
                      rdfs:range :Objet .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForRegion
:hasForRegion rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Version_Jeu ;
              rdfs:range :Region .


