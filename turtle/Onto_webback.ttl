@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/> .

<http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> rdf:type owl:Ontology ;
                                                                  owl:versionIRI <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/BelongsToEggGroup
:BelongsToEggGroup rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain :Pokemon ;
                   rdfs:range :Groupe_oeuf .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/CanBeFoundAsMachine
:CanBeFoundAsMachine rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf :IsMachineOfCapacite ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :Capacite ;
                     rdfs:range :Objet_capacitaire .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/CanBeFoundInVersion
:CanBeFoundInVersion rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdf:type owl:AsymmetricProperty ;
                     rdfs:domain :Objet ;
                     rdfs:range :Version_Jeu .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite_IsTypeOf
:Capacite_IsTypeOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :Capacite ;
                   rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/EvolvesTo
:EvolvesTo rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           owl:inverseOf :IsEvolutionOf ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Pokemon ;
           rdfs:range :Pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/EvolvesWithCondition
:EvolvesWithCondition rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Pokemon ;
                      rdfs:range :Declencheur_evolution .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/EvolvesWithTrigger
:EvolvesWithTrigger rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Pokemon ;
                    rdfs:range :Declencheur_evolution .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ImmuneTo
:ImmuneTo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          owl:inverseOf :IneffectiveAgainst ;
          rdfs:domain :Type_pokemon ;
          rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IneffectiveAgainst
:IneffectiveAgainst rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Type_pokemon ;
                    rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsAlternativeForm
:IsAlternativeForm rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :Pokemon ;
                   rdfs:range :Alternative .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsEvolutionOf
:IsEvolutionOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Pokemon ;
               rdfs:range :Pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsEvolvedFromCondition
:IsEvolvedFromCondition rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain :Pokemon ;
                        rdfs:range :Condition_evolution .


