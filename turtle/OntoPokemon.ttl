@prefix : <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/> .

<http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> rdf:type owl:Ontology ;
                                                                  owl:versionIRI <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon> .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#BelongsToEggGroup
:BelongsToEggGroup rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain :Pokemon ;
                   rdfs:range :Groupe_oeuf .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#CanBeFoundAsMachine
:CanBeFoundAsMachine rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf :IsMachineOfCapacite ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                     rdfs:range :Objet_capacitaire .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#CanBeFoundInVersion
:CanBeFoundInVersion rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdf:type owl:AsymmetricProperty ;
                     rdfs:domain :Objet ;
                     rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Version_Jeu> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#EvolvesWithCondition
:EvolvesWithCondition rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Pokemon ;
                      rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Declencheur_evolution> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#ImmuneTo
:ImmuneTo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          owl:inverseOf :IneffectiveAgainst ;
          rdfs:domain :Type_pokemon ;
          rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#IneffectiveAgainst
:IneffectiveAgainst rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Type_pokemon ;
                    rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#IsEvolvedFromCondition
:IsEvolvedFromCondition rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain :Pokemon ;
                        rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Condition_evolution> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#IsEvolvedFromTrigger
:IsEvolvedFromTrigger rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Pokemon ;
                      rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Declencheur_evolution> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#IsMachineOfCapacite
:IsMachineOfCapacite rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :Objet_capacitaire ;
                     rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Lieu_IsLocatedIn
:Lieu_IsLocatedIn rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:FunctionalProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Lieu ;
                  rdfs:range :Lieu .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Object_IsLocatedIn
:Object_IsLocatedIn rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    owl:inverseOf :hasForFoundableItems ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain :Objet ;
                    rdfs:range :Lieu .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#TriggerLinkedToObject
:TriggerLinkedToObject rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Utilisation_Objet> ;
                       rdfs:range :Objet .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#hasForFoundableItems
:hasForFoundableItems rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdf:type owl:InverseFunctionalProperty ;
                      rdfs:domain :Lieu ;
                      rdfs:range :Objet .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#hasForRegion
:hasForRegion rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Version_Jeu> ;
              rdfs:range :Region .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite_IsTypeOf
:Capacite_IsTypeOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                   rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/EvolvesTo
:EvolvesTo rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           owl:inverseOf :IsEvolutionOf ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain [ rdf:type owl:Restriction ;
                         owl:onProperty :EvolvesTo ;
                         owl:someValuesFrom :Pokemon
                       ] ;
           rdfs:range :Pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/EvolvesWithTrigger
:EvolvesWithTrigger rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Pokemon ;
                    rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Declencheur_evolution> .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsAlternativeForm
:IsAlternativeForm rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain :Pokemon ;
                   rdfs:range :Alternative .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/IsEvolutionOf
:IsEvolutionOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Pokemon ;
               rdfs:range :Pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Pokemon_IsTypeOf
:Pokemon_IsTypeOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Pokemon ;
                  rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/PokemonhasForCapaciteCapacite
:PokemonhasForCapaciteCapacite rdf:type owl:ObjectProperty ;
                               owl:deprecated "true"^^xsd:boolean .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/ResistantTo
:ResistantTo rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :WeakAgainst ;
             rdfs:domain :Type_pokemon ;
             rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/StrongAgainst
:StrongAgainst rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :WeakTo ;
               rdfs:domain :Type_pokemon ;
               rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/WeakAgainst
:WeakAgainst rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Type_pokemon ;
             rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/WeakTo
:WeakTo rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        rdfs:domain :Type_pokemon ;
        rdfs:range :Type_pokemon .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise
:hasForCapaciteApprise rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain :Pokemon ;
                       rdfs:range [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasForCapaciteApprise ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasForCapaciteApprise ;
                                    owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                                    owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                  ] ;
                       rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les 1 à 4 capacités (Capacite) que ce pokémon connaît actuellement."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnable
:hasForCapaciteLearnable rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain :Pokemon ;
                         rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                         rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les capacités (Capacite) que ce pokémon peut apprendre."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnableByLevel
:hasForCapaciteLearnableByLevel rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                rdfs:domain :Pokemon ;
                                rdfs:range [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasForCapaciteLearnableByLevel ;
                                             owl:someValuesFrom <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                                           ] ;
                                rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par montée en niveau."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteLearnableByMachines
:hasForCapaciteLearnableByMachines rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf :hasForCapaciteLearnable ;
                                   rdfs:comment "Correspond au lien entre un pokémon et les capacités que ce pokémon peut apprendre par CT, DT ou bien CS."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCaracteristic
:hasForCaracteristic rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite> ;
                     rdfs:range <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Caracteristique_capacite> ;
                     rdfs:comment "Lien entre une capacité (Capacite) et une de ses caractéristique (Caractéristique_Capacité)."@fr .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForEvolution
:hasForEvolution rdf:type owl:ObjectProperty ;
                 rdfs:comment "DEPRECATED Lien entre un pokémon (Pokemon) et un de ses pokémons (Pokemon) en lequel il évolue."@fr ;
                 owl:deprecated "true"^^xsd:boolean .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/isTypeOf
:isTypeOf rdf:type owl:ObjectProperty ;
          owl:deprecated "true"^^xsd:boolean .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#generation
:generation rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Version_Jeu> ;
            rdfs:range xsd:int .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/niveau
:niveau rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#Monte_niveau> ;
        rdfs:range xsd:int .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/nom
:nom rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf owl:topDataProperty ;
     rdfs:domain owl:Thing ;
     rdfs:range rdf:langString .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/precision_attaque
:precision_attaque rdf:type owl:DatatypeProperty ;
                   rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Precision_capacite> ;
                   rdfs:range xsd:decimal ;
                   owl:deprecated "true"^^xsd:boolean .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/precision_capacite
:precision_capacite rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Precision_capacite> ;
                    rdfs:range xsd:decimal .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/puissance_attaque
:puissance_attaque rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Puissance_capacite> ;
                   rdfs:range xsd:decimal ;
                   owl:deprecated "true"^^xsd:boolean .


###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/puissance_capacite
:puissance_capacite rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Puissance_capacite> ;
                    rdfs:range xsd:decimal .


