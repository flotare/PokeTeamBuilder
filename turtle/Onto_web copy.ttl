### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#embargo
:embargo rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :dark ;
                    :puissance_capacite 0 ;
                    :pp_capacite 15 ;
                    :priorite_capacite 0 ;
                    :nom "embargo" ;
                    :description_capacite "La cible ne peut pas utiliser son objet tenu pendant cinq tours. Si la cible quitte le terrain, cet effet prend fin. Si un Pokémon sous cet effet utilise bug bite ou pluck sur un Pokémon portant une baie, la baie est détruite mais pas utilisée. Si un Pokémon sous cet effet utilise fling, elle échouera. Cet effet est transmis par baton pass." ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#fling
:fling rdf:type owl:NamedIndividual ,
                             :Capacite_physique ;
                    :Capacite_IsTypeOf :dark ;
                    :puissance_capacite 0 ;
                    :pp_capacite 10 ;
                    :priorite_capacite 0 ;
                    :nom "fling" ;
                    :description_capacite "Inflige des dégâts réguliers. La puissance et le type sont déterminés par l'objet tenu du lanceur. L'objet est consommé. Si le lanceur ne tient pas d'objet, ou que son objet n'a pas de type et puissance définie, cette capacité échouera. Cette capacité ignore sticky hold. Si le lanceur est sous l'effet de embargo, cette capacité échouera." ;
                  :precision_capacite 100 .

