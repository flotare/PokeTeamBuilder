### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#mirror-coat
:mirror-coat rdf:type owl:NamedIndividual ,
                             :Capacite_speciale ;
                    :Capacite_IsTypeOf :psychic ;
                    :puissance_capacite 0 ;
                    :pp_capacite 20 ;
                    :priorite_capacite -5 ;
