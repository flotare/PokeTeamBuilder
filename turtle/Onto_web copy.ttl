### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#light-screen
:light-screen rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :psychic ;
                    :puissance_capacite 0 ;
                    :pp_capacite 30 ;
                    :priorite_capacite 0 ;
                    :nom "light-screen" ;
                    :description_capacite "Érige une barrière autour du côté du terrain du lanceur qui réduit les dégâts des attaques spéciales de moitié pendant cinq tours. En combats doubles, la réduction est 1/3. Les coups critiques ne sont pas affectés par la barrière. Si le lanceur tient light clay, la barrière reste pendant huit tours. brick break ou defog utilisés par un adversaire détruira la barrière." ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#haze
:haze rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :ice ;
                    :puissance_capacite 0 ;
                    :pp_capacite 30 ;
                    :priorite_capacite 0 ;
                    :nom "haze" ;
                    :description_capacite "Supprime les modifications de stat, précision, et esquive de tous les Pokémon sur le terrain. Cela ne compte pas comme une réduction de stat aux fins de clear body ou white smoke." ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#reflect
:reflect rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :psychic ;
                    :puissance_capacite 0 ;
                    :pp_capacite 20 ;
                    :priorite_capacite 0 ;
                    :nom "reflect" ;
                    :description_capacite "Érige une barrière autour du côté du terrain du lanceur qui réduit les dégâts des attaques physiques de moitié pendant cinq tours. En combats doubles, la réduction est 1/3. Les coups critiques ne sont pas affectés par la barrière. Si le lanceur tient light clay, la barrière reste pendant huit tours. brick break ou defog utilisés par un adversaire détruira la barrière." ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#focus-energy
:focus-energy rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :normal ;
                    :puissance_capacite 0 ;
                    :pp_capacite 30 ;
