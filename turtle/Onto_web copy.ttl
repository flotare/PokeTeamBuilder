### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#stealth-rock
:stealth-rock rdf:type owl:NamedIndividual ,
                             :Capacite_statut ;
                    :Capacite_IsTypeOf :rock ;
                    :puissance_capacite 0 ;
                    :pp_capacite 20 ;
                    :priorite_capacite 0 ;
                    :nom "stealth-rock" ;
                    :description_capacite "Répand des rochers pointus sur le terrain adverses, infligeant des dégâts à n'importe quel Pokémon qui entre sur le terrain d'1/8 de ses PV max. Ces dégâts sont affectés par la vulnérabilité du Pokémon entrant aux capacités rock. rapid spin supprime cet effet du côté du terrain du lanceur." ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#grass-knot
:grass-knot rdf:type owl:NamedIndividual ,
                             :Capacite_speciale ;
                    :Capacite_IsTypeOf :grass ;
                    :puissance_capacite 0 ;
                    :pp_capacite 20 ;
                    :priorite_capacite 0 ;
                    :nom "grass-knot" ;
                    :description_capacite "Inflige des dégâts réguliers. La puissance augmente avec le poids en kilogrammes de la cible, jusqu'à un maximum de 120. Poids de la cible Puissance --------------- ----: Jusqu'à 10kg 20 Jusqu'à 25kg 40 Jusqu'à 50kg 60 Jusqu'à 100kg 80 Jusqu'à 200kg 100 Plus de 200kg 120" ;
                  :precision_capacite 100 .

### http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon#chatter
:chatter rdf:type owl:NamedIndividual ,
                             :Capacite_speciale ;
                    :Capacite_IsTypeOf :flying ;
                    :puissance_capacite 65 ;
                    :pp_capacite 20 ;
                    :priorite_capacite 0 ;
                    :nom "chatter" ;
                    :description_capacite "Inflige des dégâts réguliers. A soit 1, 11, ou 31 de chances de rendre la cible confuse, basé sur le volume de l'enregistrement fait pour cette capacité; les enregistrements les plus forts augmentent la chance de confusion. Si le lanceur n'est pas un chatot, cette capacité ne causera pas de confusion. Cette capacité ne peut pas être copiée par mimic, mirror move, ou sketch, ni sélectionnée par assist, metronome, ou sleep talk." ;
                  :precision_capacite 100 .

