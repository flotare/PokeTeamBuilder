		:Objet_gameplay ;
			:nom "apricorn-box" ;
			:effect_name "Effet : Stocke les Noigrumes.<br> Description en jeu : <br>Une boîte bien pratique qui peut contenir jusqu’à<br>99 Noigrumes." ;
