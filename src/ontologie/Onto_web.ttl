		:Objet_gameplay ;
			:nom "wailmer-pail" ;
			:effect_name "Effet : Arrose les plants de Baies.<br> Description en jeu : <br>Sert à arroser les Baies plantées dans le sol." ;
			:url_img "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/wailmer-pail.png" .

