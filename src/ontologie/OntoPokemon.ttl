###  http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise
<http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise> rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Pokemon> ;
               rdfs:range [ rdf:type owl:Restriction ;
                            owl:onProperty <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise> ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/hasForCapaciteApprise> ;
                            owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
                            owl:onClass <http://www.semanticweb.org/arthu/ontologies/2026/0/OntoPokemon/Capacite>
                          ] ;
               rdfs:comment "Correspond au lien entre un pokémon (Pokemon) et les 1 à 4 capacités (Capacite) que ce pokémon connaît actuellement."@fr .


